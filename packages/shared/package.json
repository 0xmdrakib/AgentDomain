{
  "name": "@agentdomain/shared",
  "version": "0.8.0",
  "description": "Public TypeScript contracts, Zod schemas, constants, and utilities for AgentDomain",
  "keywords": [
    "agentdomain",
    "ai-agents",
    "typescript",
    "schemas",
    "zod",
    "base"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xmdrakib/AgentDomain.git",
    "directory": "packages/shared"
  },
  "homepage": "https://docs.agentdomain.app/sdk/typescript",
  "bugs": {
    "url": "https://github.com/0xmdrakib/AgentDomain/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "default": "./dist/constants.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "default": "./dist/utils.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "echo ok"
  },
  "dependencies": {
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
