{
  "name": "@agentdomain/mcp-server",
  "version": "0.11.0",
  "description": "Secure-by-default MCP server for AgentDomain identity, DNS, email, and renewal workflows",
  "keywords": [
    "agentdomain",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "identity",
    "x402",
    "base"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xmdrakib/AgentDomain.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://docs.agentdomain.app/sdk/mcp",
  "bugs": {
    "url": "https://github.com/0xmdrakib/AgentDomain/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentdomain-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "examples/crewai/readonly_flow.py",
    "examples/crewai/README.md",
    "examples/crewai/requirements.in",
    "examples/crewai/requirements.lock",
    "examples/autogen/agentdomain_workbench.py",
    "examples/autogen/assistant_example.py",
    "examples/autogen/inspect_renewal.py",
    "examples/autogen/README.md",
    "examples/autogen/requirements.txt",
    "examples/autogen/constraints.txt",
    "README.md",
    "LICENSE",
    "NOTICE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "pnpm --filter @agentdomain/sdk build && pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"no lint\""
  },
  "dependencies": {
    "@agentdomain/sdk": "workspace:^",
    "@agentdomain/shared": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "viem": "^2.56.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
