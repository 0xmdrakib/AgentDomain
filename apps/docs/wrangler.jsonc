{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentdomain-docs",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "docs.agentdomain.app",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": false,
  },
  "env": {
    "preview": {
      "name": "agentdomain-docs-preview",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
    },
  },
}
