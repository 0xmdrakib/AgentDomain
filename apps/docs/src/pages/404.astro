---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Page not found',
    description: 'The requested AgentDomain documentation page does not exist or has moved.',
    editUrl: false,
    pagefind: false,
    template: 'splash',
  }}
  hasSidebar={false}
>
  <main class="not-found">
    <p class="status">404</p>
    <p>Check the URL, use documentation search, or return to a public reference page.</p>
    <nav aria-label="404 recovery links">
      <a class="primary" href="/">Documentation overview</a>
      <a href="/api-reference/overview/">API reference</a>
    </nav>
  </main>
</StarlightPage>

<style>
  .not-found {
    max-width: 40rem;
    margin: clamp(3rem, 10vh, 7rem) auto;
    text-align: center;
  }

  .status {
    margin: 0;
    color: var(--sl-color-accent);
    font-size: 1rem;
    font-weight: 700;
  }

  .not-found > p:last-of-type {
    color: var(--sl-color-gray-2);
    font-size: 1.05rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  a {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 6px;
    padding: 0.65rem 1rem;
    color: var(--sl-color-text-accent);
    font-weight: 600;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    border-color: var(--sl-color-accent);
  }

  a.primary {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
</style>
