{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", ".next/**", ".open-next/**", ".astro/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "@agentdomain/langchain-plugin#lint": {
      "dependsOn": ["^lint", "^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
